import express from 'express';
import cors from 'cors';
import multer from 'multer';
import fs from 'fs/promises';
import path from 'path';
import { fileURLToPath } from 'url';
import { v4 as uuidv4 } from 'uuid';
import { parse } from 'csv-parse/sync';
import { readState, writeState } from './storage.js';
import { scoreLead, deduplicateLeads } from './scoreEngine.js';
import { groundedDiscovery } from './gemini.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const app = express();
const port = Number(process.env.PORT || 3001);
const upload = multer({ storage: multer.memoryStorage() });

app.use(cors());
app.use(express.json({ limit: '2mb' }));
app.use(express.urlencoded({ extended: true }));

const defaultState = {
  campaigns: [],
  leads: [],
  activity: [],
};

function makeErrorResponse(message) {
  return { ok: false, error: message };
}

function normalizeLeadRecord(record, source = 'csv') {
  const companyName = record.companyName || record.company || record.company_name || 'Unknown Company';
  const companyDomain = record.companyDomain || record.domain || record.website || '';
  const evidence = [
    {
      source: 'CSV import',
      url: record.website || record.companyWebsite || 'https://example.com',
      summary: 'Imported from uploaded prospect data.',
      verified: false,
    },
  ].filter((entry) => entry.url && entry.url !== 'https://example.com');

  const lead = {
    id: uuidv4(),
    companyName,
    companyDomain,
    companyWebsite: record.website || record.companyWebsite || '',
    contactName: record.contactName || record.contact || record.first_name ? `${record.first_name || ''} ${record.last_name || ''}`.trim() : 'Unknown contact',
    email: record.email || '',
    jobTitle: record.jobTitle || record.role || record.title || '',
    seniority: record.seniority || '',
    industry: record.industry || '',
    country: record.country || record.location || '',
    companySize: record.companySize || '',
    revenue: record.revenue || '',
    sources: [source],
    technologies: Array.isArray(record.technologies) ? record.technologies : [],
    evidence,
    reasons: [],
    missing: [],
    exclusions: [],
    verificationStatus: 'unverified',
    category: 'Low Priority',
    score: 0,
    source,
    lastUpdated: new Date().toISOString(),
  };

  return lead;
}

async function persistState(nextState) {
  await writeState(nextState || defaultState);
}

app.get('/api/health', async (_req, res) => {
  res.json({ ok: true, data: { status: 'ok', service: 'PropelMatch AI Lead Finder' } });
});

app.get('/api/campaigns', async (_req, res) => {
  try {
    const state = await readState();
    res.json({ ok: true, data: state.campaigns || [] });
  } catch (error) {
    res.status(500).json(makeErrorResponse(error.message || 'Unable to load campaigns.'));
  }
});

app.post('/api/campaigns', async (req, res) => {
  try {
    const payload = req.body || {};
    const state = await readState();
    const nextCampaign = {
      id: uuidv4(),
      name: payload.name || 'New Campaign',
      industries: Array.isArray(payload.industries) ? payload.industries : ['B2B Technology'],
      companySizeMin: Number(payload.companySizeMin || 200),
      geography: Array.isArray(payload.geography) ? payload.geography : ['United States'],
      jobTitles: Array.isArray(payload.jobTitles) ? payload.jobTitles : ['CIO'],
      seniority: Array.isArray(payload.seniority) ? payload.seniority : ['Director'],
      requiredTechnologies: Array.isArray(payload.requiredTechnologies) ? payload.requiredTechnologies : [],
      excludedIndustries: Array.isArray(payload.excludedIndustries) ? payload.excludedIndustries : [],
      excludedRoles: Array.isArray(payload.excludedRoles) ? payload.excludedRoles : [],
      requiredCharacteristics: Array.isArray(payload.requiredCharacteristics) ? payload.requiredCharacteristics : [],
      instructions: payload.instructions || 'Prioritize relevant high-fit IT decision-makers.',
      isDefault: false,
      createdAt: new Date().toISOString(),
    };

    const nextCampaigns = [...(state.campaigns || []), nextCampaign];
    state.campaigns = nextCampaigns;
    await persistState(state);
    res.json({ ok: true, data: nextCampaigns });
  } catch (error) {
    res.status(500).json(makeErrorResponse(error.message || 'Unable to create campaign.'));
  }
});

app.get('/api/leads', async (_req, res) => {
  try {
    const state = await readState();
    res.json({ ok: true, data: state.leads || [] });
  } catch (error) {
    res.status(500).json(makeErrorResponse(error.message || 'Unable to load leads.'));
  }
});

app.get('/api/leads/export', async (_req, res) => {
  try {
    const state = await readState();
    const leads = state.leads || [];
    const headers = ['companyName', 'contactName', 'email', 'jobTitle', 'industry', 'country', 'score', 'category', 'verificationStatus'];
    const rows = leads.map((lead) => [lead.companyName, lead.contactName || '', lead.email || '', lead.jobTitle || '', lead.industry || '', lead.country || '', lead.score || '', lead.category || '', lead.verificationStatus || ''] );
    const csv = [headers.join(','), ...rows.map((row) => row.map((cell) => `"${String(cell).replace(/"/g, '""')}"`).join(','))].join('\n');
    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', 'attachment; filename="propelmatch-leads.csv"');
    res.send(csv);
  } catch (error) {
    res.status(500).json(makeErrorResponse(error.message || 'Unable to export leads.'));
  }
});

app.post('/api/discovery', async (req, res) => {
  try {
    const payload = req.body || {};
    const results = await groundedDiscovery({
      industry: payload.industry || 'B2B SaaS',
      keywords: payload.keywords || '',
      country: payload.country || '',
      companySize: payload.companySize || '200+',
      jobTitles: payload.jobTitles || '',
      seniority: payload.seniority || '',
      technologies: payload.technologies || '',
      resultsTarget: Number(payload.resultsTarget || 10),
      additionalInstructions: payload.additionalInstructions || '',
      model: process.env.GEMINI_MODEL || 'gemini-2.0-flash',
    });

    const leads = results.map((result, index) => ({
      id: `discovery-${uuidv4()}`,
      companyName: result.companyName || `Discovered Company ${index + 1}`,
      companyWebsite: result.website || '',
      companyDomain: result.website || '',
      contactName: result.contactName || 'Available upon verification',
      country: result.country || '',
      jobTitle: result.jobTitle || '',
      seniority: result.seniority || 'unspecified',
      industry: result.industry || '',
      companySize: result.companySize || '',
      evidence: (Array.isArray(result.evidence) ? result.evidence : []).map((item) => ({
        source: item.source || 'Search evidence',
        url: item.url || result.sourceUrl || 'https://example.com',
        summary: item.summary || result.matchReason || 'Evidence-backed match.',
        verified: Boolean(item.verified),
      })).concat(
        result.sourceUrl ? [{ source: 'Search result', url: result.sourceUrl, summary: result.matchReason || 'Grounded search result.', verified: true }] : [],
      ),
      score: 78 + Math.min(15, index * 2),
      category: index < 2 ? 'Qualified for Review' : 'Review Required',
      verificationStatus: 'partial',
      reasons: [result.matchReason || 'AI-grounded company fit.'],
      missing: [],
      exclusions: [],
      source: 'web',
      matchStatus: 'matched',
      contactStatus: result.contactName ? 'available' : 'not_available',
      companyProfile: {
        companyName: result.companyName || 'Discovered company',
        website: result.website || '',
        industry: result.industry || '',
        employees: result.companySize || '',
        headquarters: result.country || '',
        description: result.matchReason || 'Research-backed company fit from grounded search output.',
      },
      lastUpdated: new Date().toISOString(),
    }));

    res.json({ ok: true, data: leads });
  } catch (error) {
    const errorMessage = error.message || 'Discovery failed unexpectedly.';
    res.status(400).json(makeErrorResponse(errorMessage));
  }
});

app.post('/api/csv/import', upload.single('file'), async (req, res) => {
  try {
    if (!req.file) {
      throw new Error('No CSV file was uploaded.');
    }

    const content = req.file.buffer.toString('utf8');
    const records = parse(content, {
      bom: true,
      columns: true,
      skip_empty_lines: true,
      trim: true,
    });

    if (!records.length) {
      throw new Error('The CSV is empty or malformed.');
    }

    const state = await readState();
    const nextLeads = [];
    const rejected = [];

    records.forEach((record) => {
      const normalized = {
        companyName: record.company || record.company_name || record.companyName || '',
        companyDomain: record.domain || record.website || record.company_website || '',
        companyWebsite: record.website || record.company_website || record.domain || '',
        contactName: record.contact_name || record.contact || record.name || '',
        email: record.email || '',
        jobTitle: record.job_title || record.role || record.title || '',
        seniority: record.seniority || '',
        industry: record.industry || '',
        country: record.country || record.location || '',
        companySize: record.company_size || record.employees || '',
        revenue: record.revenue || '',
        technologies: (record.technologies || '')
          .split(/[;,]/)
          .map((item) => item.trim())
          .filter(Boolean),
      };

      const requiredCompany = normalized.companyName?.trim();
      if (!requiredCompany) {
        rejected.push(record);
        return;
      }

      const candidate = normalizeLeadRecord(normalized, 'csv');
      const scored = scoreLead(candidate, state.campaigns?.[0] || null);
      candidate.score = scored.score;
      candidate.category = scored.category;
      candidate.reasons = scored.reasons;
      candidate.missing = scored.missing;
      candidate.exclusions = scored.exclusions;
      candidate.verificationStatus = scored.verificationStatus;
      candidate.companyProfile = {
        companyName: candidate.companyName,
        website: candidate.companyWebsite,
        industry: candidate.industry,
        employees: candidate.companySize,
        headquarters: candidate.country,
        revenue: candidate.revenue,
        technologies: candidate.technologies,
        description: 'Imported lead processed with deterministic scoring.',
      };
      nextLeads.push(candidate);
    });

    const deduped = deduplicateLeads([...state.leads, ...nextLeads]);
    state.leads = deduped;
    state.activity = [
      {
        id: uuidv4(),
        type: 'csv_import',
        message: `Imported ${nextLeads.length} CSV rows with ${rejected.length} rejections.`,
        createdAt: new Date().toISOString(),
      },
      ...(state.activity || []),
    ];

    await persistState(state);
    res.json({
      ok: true,
      data: {
        importedCount: nextLeads.length,
        rejectedCount: rejected.length,
        rows: records.slice(0, 8),
        leads: deduped.slice(-100),
      },
    });
  } catch (error) {
    res.status(400).json(makeErrorResponse(error.message || 'CSV import failed.'));
  }
});

const distPath = path.join(__dirname, '..', 'dist');
app.use(express.static(distPath));

app.get('*', async (req, res, next) => {
  try {
    const distExists = await fs.access(distPath).then(() => true).catch(() => false);
    if (!distExists) {
      res.status(200).json({ ok: true, message: 'API server is running. Build the frontend to serve the app.' });
      return;
    }
    res.sendFile(path.join(distPath, 'index.html'));
  } catch (error) {
    next(error);
  }
});

app.listen(port, () => {
  console.log(`PropelMatch server listening on http://localhost:${port}`);
});
